  m_Name: Chelsea Diary
  m_EditorClassIdentifier: Assembly-CSharp::DiaryData
  transcriptId: 6c67b7cc-b7f1-4fd5-bc43-875451294e03
  title: Chelsea's Diary
  mission: {fileID: 11400000, guid: 8a619ff05acad9d43a566640fcd02f31, type: 2}
  OnTranscriptClosed:
    m_PersistentCalls:
      m_Calls: []
  diaryTitle: 
  leftTextBox: "I can\u2019t believe there are only two weeks left\u2026 Two weeks
    left and Luke still hasn\u2019t tried to talk to me again. Which, I know! Is
    technically my fault, but can you blame me? I mean, we used to make plans together.
    Together. But nowadays, it's just been me [doing everything].\r\n\r\nMaybe it\u2019s
    not such a big deal? But it really matters to me. I just wish I knew if he felt
    the same. Ugh, was it a mistake? Taking a break? No. No, I needed a break. But
    I still want to talk to him. No, more like I want him to talk to me. Reach out
    to me again. \r\n\r\nBack in junior year, when he gave me those three little
    flowers he\u2019d picked and asked me out. And then we\u2019d make plans, and
    sometimes he\u2019d get me them again. Something like that would be nice. Just
    something to show me he still wants to spend time together.\r\n"
  rightTextBox: 
  imageToShow: {fileID: 21300000, guid: 845a04b4342473b4cb19a88b3467afff, type: 3}
